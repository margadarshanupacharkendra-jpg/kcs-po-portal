# When you connect the "Upstash Redis" integration to this project from the
# Vercel Marketplace, Vercel automatically creates these for you — you do
# not need to fill them in by hand for a deployed project.
# Only needed here if you want to run `next dev` locally against your real
# database (copy values from Vercel > Storage > your Redis DB > .env.local tab).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional but recommended once live: set your own value here (and in
# Vercel's Environment Variables) instead of relying on the code defaults.
SESSION_SECRET=

# Optional: override the default login credentials without touching code.
ADMIN_USERNAME=
ADMIN_PASSWORD=
STAFF_USERNAME=
STAFF_PASSWORD=
